{
  "name": "@textile/signing-guard",
  "version": "0.2.0",
  "private": true,
  "description": "Fireblocks Co-Signer Callback Handler that approves only the EIP-712 messages a Stitch bot is allowed to request and rejects everything else.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/textile-protocol/textile-signing-guard.git"
  },
  "homepage": "https://github.com/textile-protocol/textile-signing-guard#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "signing-guard": "dist/src/cli.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'",
    "start": "node dist/src/cli.js serve",
    "acceptance": "node dist/src/cli.js acceptance",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
